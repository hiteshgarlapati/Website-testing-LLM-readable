# =============================================================================
# Production (copy to `.env` at repo root before docker compose)
# =============================================================================
#
# 1. Set SITE_URL to your real public HTTPS URL *before* building the image.
# 2. Set ADMIN_SECRET to a long random string (required for /admin uploads).
# 3. Run: docker compose up -d --build
#
# Changing SITE_URL later requires: docker compose build --no-cache && docker compose up -d
#
# First deploy with a broken/empty catalogue volume? Restart the container after pull —
# entrypoint merges seed images and repairs empty items.json automatically.

NODE_ENV=production
PORT=8004
SITE_URL=https://quillovan.com

ADMIN_SECRET=change-me-to-a-long-random-secret

# Set inside the container by docker-compose (do not change unless self-hosting Node)
# DATA_DIR=/app/data
# SEED_DIR=/app/seed
