# =============================================================================
# Production environment (copy to `.env` before docker compose / local builds)
# =============================================================================
# SITE_URL must be your public HTTPS domain. It is baked into the static build
# (JSON-LD, sitemap, llms.txt, products.json absolute image URLs).
#
# Example:
#   SITE_URL=https://www.yourdomain.com

NODE_ENV=production
PORT=8004
SITE_URL=https://oaklinefurniture.example
