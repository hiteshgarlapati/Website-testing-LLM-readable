# =============================================================================
# Production (copy to `.env` at repo root before docker compose / Node deploy)
# =============================================================================

NODE_ENV=production
PORT=8004
SITE_URL=https://quillovan.com

# Required in production for /admin Excel uploads (use a long random string)
ADMIN_SECRET=change-me-to-a-long-random-secret

# Set automatically in Docker; optional for bare-metal Node deploy
# DATA_DIR=/var/lib/quillovan/data
