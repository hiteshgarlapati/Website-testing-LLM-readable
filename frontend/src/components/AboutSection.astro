---
import {
  BUSINESS,
  addressLines,
  contactEmail,
  contactPhone,
  deliveryPolicy,
  placeLabel,
  telHref
} from '../lib/business.js';

const lines = addressLines();
const phone = contactPhone();
const email = contactEmail();
---
<section id="about" aria-labelledby="about-h" class="about-section">
  <div class="about-col-main">
    <h2 id="about-h" class="about-title">About us</h2>
    <p>
      Quillovan is a two-person shop. Dana mills and joins; Peter finishes and delivers. We have made furniture in {placeLabel()} since {BUSINESS.foundedYear}, from hardwood bought within {BUSINESS.sourcingRadiusKm} km of the shop.
    </p>
    <p style="margin-top: 16px;">
      Every joint is mechanical — mortise, tenon, dovetail — so a piece can be taken apart and repaired instead of replaced. Send us a photo if something breaks, whenever that happens; repairs on our own work are free for the first ten years.
    </p>
  </div>
  
  <div class="about-col-contact">
    <h3 class="overline-header">Visit or write</h3>
    <ul class="contact-list">
      {lines.length > 0 && <li set:html={lines.join('<br />')} />}
      <li>Tuesday–Saturday, 10am–6pm</li>
      {phone && <li><a href={telHref()}>{phone}</a></li>}
      {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
    </ul>
    <p class="delivery-note">
      {deliveryPolicy()}
    </p>
  </div>
</section>

<style>
  .about-section {
    margin: 96px 0 0;
    padding: 56px 0 0;
    border-top: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: 48px;
  }
  .about-title {
    margin: 0 0 20px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 40px;
    letter-spacing: -0.01em;
  }
  .about-col-main p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .overline-header {
    margin: 0 0 14px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-subtle);
    font-weight: 600;
  }
  .contact-list {
    list-style: none;
    display: grid;
    gap: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .delivery-note {
    margin: 22px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-subtle);
  }

  @media (max-width: 992px) {
    .about-section {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
