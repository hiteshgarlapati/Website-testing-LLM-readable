---
import { imageSize } from '../lib/imageSize.js';
import { imageAlt, primaryMaterial } from '../lib/material.js';

export interface Props {
  item: {
    name: string;
    slug: string;
    category: string;
    formattedPrice: string;
    availability: string;
    description: string;
    specs: string[];
    image: string;
  };
  /** Above-the-fold cards load eagerly so the LCP image is not deferred. */
  priority?: boolean;
}

const { item, priority = false } = Astro.props;

// Two specs keep the card the same height as the open-slot placeholder. With
// specs empty across the catalogue, fall back to the material the copy states.
const material = primaryMaterial(item);
const summarySpecs = item.specs.length ? item.specs.slice(0, 2).join(' · ') : material;
const inStock = item.availability.includes('In stock');
const size = imageSize(item.image);
---

<article class="card">
  <a href={`/product/${item.slug}`} class="card-image" aria-label={`View details for ${item.name}`}>
    <img
      src={item.image}
      alt={imageAlt(item)}
      width={size?.width}
      height={size?.height}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
    />
  </a>
  <div class="card-body">
    <h4><a href={`/product/${item.slug}`}>{item.name}</a></h4>
    <p class="card-desc">{item.description}</p>
    <p class="card-specs">{summarySpecs}</p>
    <p class="card-foot">
      <strong>{item.formattedPrice}</strong>
      <span class:list={['status', inStock ? 'in-stock' : 'to-order']}>{item.availability}</span>
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .card-image {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #EAE1D6;
    display: block;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card-image:hover img {
    transform: scale(1.04);
  }
  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .card-body h4 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
  }
  .card-body h4 a {
    color: var(--text-dark);
  }
  .card-body h4 a:hover {
    color: var(--accent-terracotta);
  }
  .card-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .card-specs {
    font-size: 12px;
    color: var(--text-subtle);
  }
  .card-foot {
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding-top: 6px;
  }
  .card-foot strong {
    font-size: 16px;
    font-weight: 600;
  }
  .status {
    font-size: 12px;
    white-space: nowrap;
  }
  .in-stock { color: var(--accent-green); }
  .to-order { color: var(--accent-terracotta); }
</style>
