<style>
  .hero-section {
    padding: 64px 0 44px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
  }
  .meta-overline {
    margin: 0 0 18px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .main-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 5.5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--text-dark);
    text-wrap: balance;
  }
  .hero-description {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0 0 34px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav-tag {
    border: 1px solid rgba(28, 26, 23, 0.22);
    border-radius: 999px;
    padding: 9px 18px;
    font-size: 14px;
    color: var(--text-dark);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .nav-tag:hover {
    background: var(--text-dark);
    color: var(--bg-main);
    text-decoration: none;
  }
  .ai-tag {
    background: rgba(163, 77, 51, 0.08);
    border-color: rgba(163, 77, 51, 0.4);
    color: var(--accent-terracotta);
    font-weight: 500;
  }
  .ai-tag:hover {
    background: var(--accent-terracotta);
    color: #fff;
  }

  @media (max-width: 992px) {
    .hero-section {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
