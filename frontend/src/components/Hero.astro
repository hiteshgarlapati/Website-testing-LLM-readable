<section aria-labelledby="intro-h" class="hero-section">
  <div class="hero-headline">
    <p class="meta-overline">Grand Rapids, Michigan · Est. 2014</p>
    <h1 id="intro-h" class="main-title">Beds, chairs, tables and sofas. Twelve pieces, nothing else.</h1>
  </div>
  <p class="hero-description">
    We keep one small catalogue and build every order by hand in our shop on Wealthy Street. Everything on this page is in stock or made to order in four to six weeks, shipped flat-packed or delivered fully assembled within Michigan.
  </p>
</section>

<!-- Category Jump Nav -->
<nav aria-label="Jump to a category" class="category-nav">
