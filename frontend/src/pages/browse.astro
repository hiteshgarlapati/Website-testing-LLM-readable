---
import Layout from '../layouts/Layout.astro';
import CatalogueRows from '../components/CatalogueRows.astro';
import { readItems } from '../lib/itemsStore.js';
import { absoluteUrl, siteOrigin } from '../lib/urls.js';
import { buildRows } from '../lib/catalogue.js';
import { publishableItems } from '../lib/publishable.js';
import { placeLabel } from '../lib/business.js';
import { primaryMaterial } from '../lib/material.js';

export const prerender = true;

const site = siteOrigin(Astro.site);
const absoluteImage = (img) => absoluteUrl(site, img);

const itemsData = await readItems();
const liveItems = publishableItems(itemsData);
const rows = buildRows(liveItems);
const filledCount = liveItems.length;
const browseLede =
  filledCount === 0
    ? 'Four categories, twenty slots each. No pieces are live yet — use Admin to import Excel workbooks or seed the server catalogue volume.'
    : `Four categories. ${filledCount} piece${filledCount === 1 ? '' : 's'} live today; open slots stay reserved for pieces still on the bench. Scroll each row with the arrows or by dragging.`;

// CollectionPage rather than a second FurnitureStore: this page groups the same
// products the home page lists, so it must not claim to be another storefront.
// Only filled slots become Products — open slots are layout, not inventory.
const browseSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${site}/browse#page`,
  "name": "Browse the Quillovan Furniture catalogue",
  "description": "All Quillovan pieces by category — sofas, chairs, tables and beds, with prices and availability in the page source.",
  "url": `${site}/browse`,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Quillovan Furniture",
    "url": `${site}/`
  },
  "hasPart": rows.map(row => ({
    "@type": "ItemList",
    "@id": `${site}/browse#${row.id}`,
    "name": row.name,
    "description": row.subtitle,
    "numberOfItems": row.filled.length,
    "itemListElement": row.filled.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Product",
        "name": item.name,
        "sku": item.id,
        "category": item.category,
        "description": item.description,
        "url": `${site}/product/${item.slug}`,
        "image": absoluteImage(item.image),
        ...(primaryMaterial(item) ? { "material": primaryMaterial(item) } : {}),
        "brand": { "@type": "Brand", "name": "Quillovan" },
        "offers": {
          "@type": "Offer",
          "price": item.price,
          "priceCurrency": "INR",
          "availability": item.schemaAvailability,
          "url": `${site}/product/${item.slug}`
        }
      }
    }))
  }))
};
---

<Layout
  title={`Browse the catalogue — Quillovan Furniture, ${placeLabel()}`}
  description="Browse every Quillovan piece by category: sofas, chairs, tables and beds. Filterable, with prices and availability in the page source."
  jsonLd={browseSchema}
  search={true}
>
  <main class="page-container" id="top">
    <div class="browse-head">
      <p class="crumb"><a href="/">Home</a> · Browse</p>
      <h1>Browse the catalogue</h1>
      <p class="browse-lede">{browseLede}</p>
    </div>

    <CatalogueRows items={liveItems} headingId="browse-h" heading="Products" resetHref="/browse" />
  </main>
</Layout>

<style>
  .browse-head {
    padding: 44px 0 28px;
  }
  .crumb {
    margin-bottom: 12px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .browse-head h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .browse-lede {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 62ch;
    text-wrap: pretty;
  }
</style>
