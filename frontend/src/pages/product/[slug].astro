---
import Layout from '../../layouts/Layout.astro';
import itemsData from '../../../../backend/items.json';

export async function getStaticPaths() {
  return itemsData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

// Individual Product Schema.org JSON-LD for AI crawlers & LLM agents
const productSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://oaklinefurniture.example/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": item.category,
          "item": `https://oaklinefurniture.example/#${item.categoryId}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": item.name,
          "item": `https://oaklinefurniture.example/product/${item.slug}`
        }
      ]
    },
    {
      "@type": "Product",
      "@id": `https://oaklinefurniture.example/product/${item.slug}#product`,
      "name": item.name,
      "category": item.category,
      "material": item.specs[0] || "Solid wood",
      "description": item.description,
      "image": [
        `https://oaklinefurniture.example${item.image}`
      ],
      "brand": {
        "@type": "Brand",
        "name": "Oakline"
      },
      "manufacturer": {
        "@type": "Organization",
        "name": "Oakline Furniture",
        "address": "Grand Rapids, Michigan"
      },
      "offers": {
        "@type": "Offer",
        "url": `https://oaklinefurniture.example/product/${item.slug}`,
        "priceCurrency": "USD",
        "price": item.price,
        "availability": item.schemaAvailability,
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {
          "@type": "Organization",
          "name": "Oakline Furniture"
        }
      }
    }
  ]
};

// Find 2 related items in the same category (or fallback to others)
const relatedItems = itemsData
  .filter(p => p.categoryId === item.categoryId && p.id !== item.id)
  .slice(0, 2);
---

<Layout title={`${item.name} | Oakline Furniture`} description={item.description} jsonLd={productSchema}>
  <main class="page-container" id="top">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="breadcrumb-nav">
      <ol>
        <li><a href="/">Catalogue</a></li>
        <li><span aria-hidden="true" class="divider">/</span></li>
        <li><a href={`/#${item.categoryId}`}>{item.category}</a></li>
        <li><span aria-hidden="true" class="divider">/</span></li>
        <li aria-current="page"><strong>{item.name}</strong></li>
      </ol>
      <div class="ai-links">
        <a href="/products.json" target="_blank" class="badge-link">⚡ AI JSON API</a>
      </div>
    </nav>

    <!-- Main Product Layout -->
    <section aria-labelledby="product-title" class="product-layout">
      <!-- Product Image Display -->
      <div class="product-visuals">
        <div class="main-image-card">
          <img src={item.image} alt={item.name} />
        </div>
        <div class="craftsmanship-box">
          <h4>Grand Rapids Craftsmanship</h4>
          <p>Every piece is joined mechanically with tenons and dovetails from locally milled hardwood within 200 miles of Wealthy Street. Repairs are covered free for ten years.</p>
        </div>
      </div>

      <!-- Product Specifications & Actions -->
      <div class="product-details">
        <span class:list={['status-badge', { 'stock-status': item.availability.includes('In stock'), 'order-status': !item.availability.includes('In stock') }]}>
          {item.availability}
        </span>
        <h1 id="product-title" class="title">{item.name}</h1>
        <p class="price-display">{item.formattedPrice}</p>

        <div class="description-block">
          <h2>Overview</h2>
          <p>{item.description}</p>
        </div>

        <!-- Specifications & Dimensions -->
        <div class="specs-block">
          <h2>Specifications & Highlights</h2>
          <ul class="specs-list">
            {item.specs.map(spec => (
              <li>
                <span class="checkmark">✔</span>
                <span>{spec}</span>
              </li>
            ))}
            <li><span class="checkmark">✔</span> <span>Handmade in Grand Rapids, MI</span></li>
            <li><span class="checkmark">✔</span> <span>10-Year Repair Warranty included</span></li>
          </ul>
        </div>

        <!-- Order / Inquiry Call to Action -->
        <div class="action-card">
          <h3>Order & Commission Inquiry</h3>
          <p>Since we build in small custom batches, orders are placed directly with Dana and Peter via phone or email.</p>
          <div class="action-buttons">
            <a href={`mailto:shop@oaklinefurniture.example?subject=Inquiry: ${item.name} (${item.formattedPrice})`} class="btn-primary">
              ✉ Email Shop to Order
            </a>
            <a href="tel:+16165550142" class="btn-secondary">
              📞 (616) 555-0142
            </a>
          </div>
          <p class="delivery-info">Free delivery and setup within 90 miles of Grand Rapids ($180 flat-rate crating across lower 48 states).</p>
        </div>
      </div>
    </section>

    <!-- Related Pieces -->
    {relatedItems.length > 0 && (
      <section aria-labelledby="related-title" class="related-section">
        <div class="related-header">
          <h2 id="related-title">More in {item.category}</h2>
          <a href={`/#${item.categoryId}`} class="view-all">View all {item.category.toLowerCase()} →</a>
        </div>
        <ul class="related-grid">
          {relatedItems.map(rel => (
            <li>
              <article class="mini-card">
                <a href={`/product/${rel.slug}`} class="mini-img">
                  <img src={rel.image} alt={rel.name} loading="lazy" />
                </a>
                <div class="mini-info">
                  <h4><a href={`/product/${rel.slug}`}>{rel.name}</a></h4>
                  <p class="mini-price">{rel.formattedPrice} · <span class="mini-status">{rel.availability}</span></p>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>

<style>
  .page-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* Breadcrumbs */
  .breadcrumb-nav {
    padding: 24px 0;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .breadcrumb-nav ol {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .divider {
    color: #A0968C;
  }
  .badge-link {
    font-size: 13px;
    background: rgba(163, 77, 51, 0.08);
    border: 1px solid rgba(163, 77, 51, 0.4);
    color: var(--accent-terracotta);
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
  }
  .badge-link:hover {
    background: var(--accent-terracotta);
    color: #fff;
  }

  /* Product Layout */
  .product-layout {
    padding: 48px 0 64px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 56px;
    align-items: start;
  }
  .main-image-card {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: #EAE1D6;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .main-image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .craftsmanship-box {
    margin-top: 24px;
    padding: 20px;
    background: #EFEAE2;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
  }
  .craftsmanship-box h4 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    margin-bottom: 8px;
  }
  .craftsmanship-box p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Details Column */
  .status-badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 12px;
  }
  .stock-status {
    background: rgba(47, 107, 79, 0.12);
    color: var(--accent-green);
  }
  .order-status {
    background: rgba(163, 77, 51, 0.12);
    color: var(--accent-terracotta);
  }
  .title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1.1;
    color: var(--text-dark);
    margin-bottom: 8px;
  }
  .price-display {
    font-size: 26px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 28px;
  }

  .description-block, .specs-block {
    margin-bottom: 36px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 20px;
  }
  .description-block h2, .specs-block h2 {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: 12px;
  }
  .description-block p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .specs-list {
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 16px;
    color: var(--text-dark);
  }
  .specs-list li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .checkmark {
    color: var(--accent-terracotta);
    font-size: 14px;
  }

  /* Action Card */
  .action-card {
    background: #EFEAE2;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 28px;
    margin-top: 36px;
  }
  .action-card h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    margin-bottom: 8px;
  }
  .action-card p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 16px;
  }
  .btn-primary, .btn-secondary {
    flex: 1;
    min-width: 200px;
    height: 48px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: var(--text-dark);
    color: #F6F2EC;
    border: 1px solid var(--text-dark);
  }
  .btn-primary:hover {
    background: var(--accent-terracotta);
    border-color: var(--accent-terracotta);
    color: #fff;
  }
  .btn-secondary {
    background: #FFFDFA;
    color: var(--text-dark);
    border: 1px solid var(--border-input);
  }
  .btn-secondary:hover {
    border-color: var(--text-dark);
    background: var(--text-dark);
    color: #F6F2EC;
  }
  .delivery-info {
    font-size: 13px !important;
    color: var(--text-subtle) !important;
    margin-bottom: 0 !important;
  }

  /* Related Section */
  .related-section {
    padding: 48px 0;
    border-top: 1px solid var(--border-subtle);
    margin-bottom: 40px;
  }
  .related-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .related-header h2 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 400;
  }
  .view-all {
    font-size: 15px;
    font-weight: 500;
  }
  .related-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 36px;
  }
  .mini-card {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .mini-img {
    width: 120px;
    aspect-ratio: 4/3;
    background: #EAE1D6;
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .mini-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .mini-img:hover img {
    transform: scale(1.05);
  }
  .mini-info h4 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    margin-bottom: 4px;
  }
  .mini-info h4 a {
    color: var(--text-dark);
  }
  .mini-price {
    font-size: 14px;
    color: var(--text-muted);
  }
  .mini-status {
    color: var(--accent-terracotta);
  }

  @media (max-width: 860px) {
    .product-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
