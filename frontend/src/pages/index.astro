---
import Layout from '../layouts/Layout.astro';
import CatalogueRows from '../components/CatalogueRows.astro';
import AboutSection from '../components/AboutSection.astro';
import itemsData from '../data/items.json';
import { absoluteUrl, siteOrigin } from '../lib/urls.js';
import { buildRows } from '../lib/catalogue.js';

const site = siteOrigin(Astro.site);
const absoluteImage = (img) => absoluteUrl(site, img);

// Only real pieces reach the structured data; the open slots the catalogue
// renders are presentation and must never be described as products.
const groupedItems = buildRows(itemsData).map(row => ({ ...row, items: row.filled }));

// Build comprehensive Schema.org JSON-LD for AI crawlers & LLM reading
const catalogueSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FurnitureStore",
      "@id": `${site}/#store`,
      "name": "Oakline Furniture",
      "description": "Solid-wood beds, chairs, tables and sofas made in small batches in Grand Rapids, Michigan. Twelve pieces, built to order.",
      "url": `${site}/`,
      "telephone": "+1-616-555-0142",
      "priceRange": "$340-$3,240",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "418 Wealthy Street SE",
        "addressLocality": "Grand Rapids",
        "addressRegion": "MI",
        "postalCode": "49503",
        "addressCountry": "US"
      },
      "openingHours": "Tu-Sa 10:00-18:00"
    },
    ...groupedItems.map(cat => ({
      "@type": "ItemList",
      "@id": `${site}/#${cat.id}`,
      "name": cat.name,
      "description": cat.subtitle,
      "numberOfItems": cat.items.length,
      "itemListElement": cat.items.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Product",
          "name": item.name,
          "category": item.category,
          "description": item.description,
          "url": `${site}/product/${item.slug}`,
          "image": absoluteImage(item.image),
          "sku": item.id,
          "material": item.specs[0] || "Solid wood",
          "brand": { "@type": "Brand", "name": "Oakline" },
          "offers": {
            "@type": "Offer",
            "price": item.price,
            "priceCurrency": "USD",
            "availability": item.schemaAvailability,
            "url": `${site}/product/${item.slug}`
          }
        }
      }))
    })),
    // Question-shaped content is what assistants quote when answering
    // "where can I buy…" style prompts.
    {
      "@type": "FAQPage",
      "@id": `${site}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Where is Oakline Furniture made?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every piece is built in small batches at our shop at 418 Wealthy Street SE in Grand Rapids, Michigan, by Dana and Peter, using hardwood sourced within 200 miles of the shop."
          }
        },
        {
          "@type": "Question",
          "name": "What wood does Oakline use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solid white oak, walnut, maple, cherry and ash. Joints are mechanical — mortise and tenon, and dovetails — rather than glued composite panels."
          }
        },
        {
          "@type": "Question",
          "name": "How much does delivery cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Delivery and assembly are free within 90 miles of Grand Rapids. Anywhere else in the lower 48 US states is a flat $180 crating fee."
          }
        },
        {
          "@type": "Question",
          "name": "Does Oakline Furniture offer a warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Repairs on any Oakline piece are free for the first 10 years."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a made-to-order piece take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most in-stock pieces ship immediately. Made-to-order pieces such as the Fenwick Sectional and Marrow Two-Seat Sofa take about 6 weeks, and the Wick Bunk Bed about 5 weeks."
          }
        },
        {
          "@type": "Question",
          "name": "How do I order from Oakline Furniture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Orders are placed directly with the shop by email at shop@oaklinefurniture.example or by phone at +1 (616) 555-0142, since each piece is built in a small custom batch."
          }
        }
      ]
    }
  ]
};
---


<Layout title="Oakline Furniture — beds, chairs, tables and sofas made in Grand Rapids, Michigan" description="Oakline Furniture is a two-person shop in Grand Rapids, Michigan making twelve solid-wood pieces across four categories: beds, chairs, tables and sofas. $340–$3,240, in stock or made to order in 4–6 weeks." jsonLd={catalogueSchema} search={true}>
  <main class="page-container" id="top">
    <section aria-labelledby="intro-h" class="intro-grid">
      <div>
        <p class="eyebrow">Grand Rapids, Michigan · Est. 2014</p>
        <h1 id="intro-h">Beds, chairs, tables and sofas. Twelve pieces, nothing else.</h1>
      </div>
      <p class="intro-lede">We keep one small catalogue and build every order by hand in our shop on Wealthy Street. Everything on this page is in stock or made to order in four to six weeks, shipped flat-packed or delivered fully assembled within Michigan.</p>
    </section>

    <section id="catalogue" aria-labelledby="cat-h" class="catalogue-section">
      <CatalogueRows items={itemsData} headingId="cat-h" heading="The catalogue" resetHref="/" />
    </section>

    <AboutSection />
  </main>
</Layout>

<style>
  .intro-grid {
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
  }
  .eyebrow {
    margin-bottom: 18px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .intro-grid h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 78px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .intro-lede {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
    max-width: 44ch;
  }
  .catalogue-section {
    padding: 44px 0 0;
  }
</style>