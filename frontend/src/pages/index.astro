---
import Layout from '../layouts/Layout.astro';
import CatalogueRows from '../components/CatalogueRows.astro';
import AboutSection from '../components/AboutSection.astro';
import { readItems } from '../lib/itemsStore.js';
import { absoluteUrl, siteOrigin } from '../lib/urls.js';
import { buildRows } from '../lib/catalogue.js';
import { publishableItems } from '../lib/publishable.js';
import { buildStoreSchema, buildWebSiteSchema, catalogPriceRange } from '../lib/storeSchema.js';
import { primaryMaterial } from '../lib/material.js';
import {
  contactEmail,
  contactPhone,
  deliveryPolicy,
  placeLabel,
  sourcingPolicy,
  workshopLabel
} from '../lib/business.js';

// The "how do I order" answer names whichever contact routes actually exist.
const orderRoutes = [
  contactEmail() ? `by email at ${contactEmail()}` : null,
  contactPhone() ? `by phone at ${contactPhone()}` : null
].filter(Boolean);
const orderAnswer = orderRoutes.length
  ? `Orders are placed directly with the shop ${orderRoutes.join(' or ')}, since each piece is built in a small custom batch.`
  : 'Orders are placed directly with the shop, since each piece is built in a small custom batch.';

export const prerender = false;

const site = siteOrigin(Astro.site);
const absoluteImage = (img) => absoluteUrl(site, img);

const itemsData = await readItems();
const liveItems = publishableItems(itemsData);
const groupedItems = buildRows(liveItems).map(row => ({ ...row, items: row.filled }));

// Build comprehensive Schema.org JSON-LD for AI crawlers & LLM reading
const catalogueSchema = {
  "@context": "https://schema.org",
  "@graph": [
    buildStoreSchema(site, { priceRange: catalogPriceRange(liveItems) }),
    buildWebSiteSchema(site),
    ...groupedItems.map(cat => ({
      "@type": "ItemList",
      "@id": `${site}/#${cat.id}`,
      "name": cat.name,
      "description": cat.subtitle,
      "numberOfItems": cat.items.length,
      "itemListElement": cat.items.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Product",
          "name": item.name,
          "category": item.category,
          "description": item.description,
          "url": `${site}/product/${item.slug}`,
          "image": absoluteImage(item.image),
          "sku": item.id,
          ...(primaryMaterial(item) ? { "material": primaryMaterial(item) } : {}),
          "brand": { "@type": "Brand", "name": "Quillovan" },
          "offers": {
            "@type": "Offer",
            "price": item.price,
            "priceCurrency": "INR",
            "availability": item.schemaAvailability,
            "url": `${site}/product/${item.slug}`
          }
        }
      }))
    })),
    // Question-shaped content is what assistants quote when answering
    // "where can I buy…" style prompts.
    {
      "@type": "FAQPage",
      "@id": `${site}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Where is Quillovan Furniture made?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Every piece is built in small batches at ${workshopLabel()} in ${placeLabel()} by Dana and Peter, using hardwood ${sourcingPolicy()}.`
          }
        },
        {
          "@type": "Question",
          "name": "What wood does Quillovan use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solid white oak, walnut, maple, cherry and ash. Joints are mechanical — mortise and tenon, and dovetails — rather than glued composite panels."
          }
        },
        {
          "@type": "Question",
          "name": "How much does delivery cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": deliveryPolicy()
          }
        },
        {
          "@type": "Question",
          "name": "Does Quillovan Furniture offer a warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Repairs on any Quillovan piece are free for the first 10 years."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a made-to-order piece take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most in-stock pieces ship immediately. Made-to-order pieces such as the Fenwick Sectional and Marrow Two-Seat Sofa take about 6 weeks, and the Wick Bunk Bed about 5 weeks."
          }
        },
        {
          "@type": "Question",
          "name": "How do I order from Quillovan Furniture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": orderAnswer
          }
        }
      ]
    }
  ]
};
---


<Layout title={`Quillovan Furniture — beds, chairs, tables and sofas made in ${placeLabel()}`} description={`Quillovan Furniture is a two-person shop in ${placeLabel()} making solid-wood pieces across four categories: beds, chairs, tables and sofas. ${catalogPriceRange(liveItems)}, in stock or made to order in 4–6 weeks.`} jsonLd={catalogueSchema} search={true}>
  <main class="page-container" id="top">
    <section aria-labelledby="intro-h" class="intro-grid">
      <div>
        <p class="eyebrow">{placeLabel()} · Est. 2014</p>
        <h1 id="intro-h">Beds, chairs, tables and sofas. {liveItems.length} pieces, nothing else.</h1>
      </div>
      <p class="intro-lede">We keep one small catalogue and build every order by hand in {workshopLabel()}. Everything on this page is in stock or made to order in four to six weeks, shipped flat-packed or delivered fully assembled across India.</p>
    </section>

    <section id="catalogue" aria-labelledby="cat-h" class="catalogue-section">
      <CatalogueRows items={liveItems} headingId="cat-h" heading="The catalogue" resetHref="/" />
    </section>

    <AboutSection />
  </main>
</Layout>

<style>
  .intro-grid {
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
  }
  .eyebrow {
    margin-bottom: 18px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .intro-grid h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 78px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .intro-lede {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
    max-width: 44ch;
  }
  .catalogue-section {
    padding: 44px 0 0;
  }
</style>