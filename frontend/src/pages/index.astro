---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import AboutSection from '../components/AboutSection.astro';
import itemsData from '../data/items.json';

const site = Astro.site?.origin ?? 'https://oaklinefurniture.example';

const absoluteImage = (img) =>
  img.startsWith('http') ? img : `${site}${img}`;

// Define the categories with their subtitles exactly as in Mockup (2)
const categories = [
  { id: 'beds', name: 'Beds', subtitle: 'Slatted platforms in maple, oak and ash — no box spring needed' },
  { id: 'chairs', name: 'Chairs', subtitle: 'Sold singly, so a set can be built one chair at a time' },
  { id: 'tables', name: 'Tables', subtitle: 'Hardwax-oiled tops that can be spot-repaired at home' },
  { id: 'sofas', name: 'Sofas', subtitle: 'Oak frames with washable covers you can re-order on their own' }
];

// Group items by categoryId
const groupedItems = categories.map(cat => ({
  ...cat,
  items: itemsData.filter(item => item.categoryId === cat.id)
}));

// Build comprehensive Schema.org JSON-LD for AI crawlers & LLM reading
const catalogueSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FurnitureStore",
      "@id": `${site}/#store`,
      "name": "Oakline Furniture",
      "description": "Solid-wood beds, chairs, tables and sofas made in small batches in Grand Rapids, Michigan. Twelve pieces, built to order.",
      "url": `${site}/`,
      "telephone": "+1-616-555-0142",
      "priceRange": "$340-$3,240",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "418 Wealthy Street SE",
        "addressLocality": "Grand Rapids",
        "addressRegion": "MI",
        "postalCode": "49503",
        "addressCountry": "US"
      },
      "openingHours": "Tu-Sa 10:00-18:00"
    },
    ...groupedItems.map(cat => ({
      "@type": "ItemList",
      "@id": `${site}/#${cat.id}`,
      "name": cat.name,
      "description": cat.subtitle,
      "numberOfItems": cat.items.length,
      "itemListElement": cat.items.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Product",
          "name": item.name,
          "category": item.category,
          "description": item.description,
          "url": `${site}/product/${item.slug}/`,
          "image": absoluteImage(item.image),
          "sku": item.id,
          "material": item.specs[0] || "Solid wood",
          "brand": { "@type": "Brand", "name": "Oakline" },
          "offers": {
            "@type": "Offer",
            "price": item.price,
            "priceCurrency": "USD",
            "availability": item.schemaAvailability,
            "url": `${site}/product/${item.slug}/`
          }
        }
      }))
    })),
    // Question-shaped content is what assistants quote when answering
    // "where can I buy…" style prompts.
    {
      "@type": "FAQPage",
      "@id": `${site}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Where is Oakline Furniture made?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every piece is built in small batches at our shop at 418 Wealthy Street SE in Grand Rapids, Michigan, by Dana and Peter, using hardwood sourced within 200 miles of the shop."
          }
        },
        {
          "@type": "Question",
          "name": "What wood does Oakline use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solid white oak, walnut, maple, cherry and ash. Joints are mechanical — mortise and tenon, and dovetails — rather than glued composite panels."
          }
        },
        {
          "@type": "Question",
          "name": "How much does delivery cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Delivery and assembly are free within 90 miles of Grand Rapids. Anywhere else in the lower 48 US states is a flat $180 crating fee."
          }
        },
        {
          "@type": "Question",
          "name": "Does Oakline Furniture offer a warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Repairs on any Oakline piece are free for the first 10 years."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a made-to-order piece take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most in-stock pieces ship immediately. Made-to-order pieces such as the Fenwick Sectional and Marrow Two-Seat Sofa take about 6 weeks, and the Wick Bunk Bed about 5 weeks."
          }
        },
        {
          "@type": "Question",
          "name": "How do I order from Oakline Furniture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Orders are placed directly with the shop by email at shop@oaklinefurniture.example or by phone at +1 (616) 555-0142, since each piece is built in a small custom batch."
          }
        }
      ]
    }
  ]
};
---

<Layout title="Oakline Furniture — Beds, Chairs, Tables & Sofas" jsonLd={catalogueSchema}>
  <main class="page-container" id="top">
    <!-- Hero & Jump Nav -->
    <Hero />

    <!-- Catalogue Section -->
    <section id="catalogue" aria-labelledby="cat-h" class="catalogue-section">
      <div class="catalogue-topbar">
        <div>
          <h2 id="cat-h" class="section-title">The catalogue</h2>
        </div>
        <div class="search-box-wrapper">
          <form role="search" class="search-form" id="search-form" onsubmit="return false;">
            <span aria-hidden="true" class="search-icon">⌕</span>
            <label for="q" class="sr-only">Search the catalogue by name, material or room</label>
            <input 
              id="q" 
              name="q" 
              type="search" 
              placeholder="Search 12 pieces — “oak”, “sofa”, “under $500”" 
              autocomplete="off" 
              class="search-input" 
            />
          </form>
          <p aria-live="polite" id="count-label" class="count-label">12 pieces in four categories</p>
        </div>
      </div>

      <!-- Categories & Products List -->
      <div id="catalogue-rows">
        {groupedItems.map(group => (
          <section id={group.id} data-row={group.id} aria-labelledby={`${group.id}-h`} class="category-group">
            <div class="category-header">
              <h3 id={`${group.id}-h`} class="category-title">{group.name}</h3>
              <p class="category-subtitle">{group.subtitle}</p>
            </div>
            
            <ul class="products-grid">
              {group.items.map(item => (
                <li data-cat={group.id} data-search={`${item.searchTerms} ${item.name} ${item.description}`.toLowerCase()}>
                  <ProductCard item={item} />
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <p id="empty-state" class="empty-state" style="display: none;">
        No piece matches that search. Try “oak”, “sofa”, or <a href="#about">email the shop</a> — we take custom commissions.
      </p>
    </section>

    <!-- About Us & Admin Portal -->
    <AboutSection />
  </main>

  <!-- Progressive Enhancement Search Script (Runs client-side without altering static HTML for scrapers) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('q');
      const countLabel = document.getElementById('count-label');
      const emptyState = document.getElementById('empty-state');
      const rows = document.querySelectorAll('section[data-row]');
      
      if (!input) return;

      function updateFilter() {
        const q = input.value.trim().toLowerCase();
        let totalShown = 0;

        rows.forEach(row => {
          let rowShown = 0;
          const items = row.querySelectorAll('li[data-cat]');
          items.forEach(li => {
            const hay = li.getAttribute('data-search') || '';
            const isHit = !q || hay.indexOf(q) !== -1;
            li.style.display = isHit ? '' : 'none';
            if (isHit) rowShown++;
          });
          row.style.display = rowShown ? '' : 'none';
          totalShown += rowShown;
        });

        if (emptyState) {
          emptyState.style.display = totalShown ? 'none' : 'block';
        }
        if (countLabel) {
          if (!q || totalShown === 12) {
            countLabel.textContent = "12 pieces in four categories";
          } else if (totalShown === 1) {
            countLabel.textContent = "1 piece matches";
          } else {
            countLabel.textContent = `${totalShown} pieces match`;
          }
        }
      }

      input.addEventListener('input', updateFilter);
    });
  </script>
</Layout>

<style>
  .page-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* Catalogue Header & Search */
  .catalogue-section {
    padding: 44px 0 0;
  }
  .catalogue-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: 36px;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .search-box-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    flex: 1;
    justify-content: flex-end;
  }
  .search-form {
    flex: 1 1 320px;
    max-width: 440px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #FFFDFA;
    border: 1px solid rgba(28, 26, 23, 0.22);
    border-radius: 999px;
    padding: 0 18px;
    height: 48px;
    transition: border-color 0.2s;
  }
  .search-form:focus-within {
    border-color: var(--accent-terracotta);
  }
  .search-icon {
    font-size: 18px;
    color: var(--text-subtle);
  }
  .search-input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    font: 400 15px/1.2 var(--font-sans);
    color: var(--text-dark);
    min-width: 0;
  }
  .count-label {
    font-size: 14px;
    color: var(--text-subtle);
    white-space: nowrap;
  }

  /* Category Rows */
  .category-group {
    scroll-margin-top: 110px;
    padding: 48px 0 0;
  }
  .category-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 0 0 18px;
    border-bottom: 1px solid rgba(28, 26, 23, 0.14);
    flex-wrap: wrap;
  }
  .category-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 28px;
  }
  .category-subtitle {
    font-size: 14px;
    color: var(--text-subtle);
  }

  /* Product Cards Grid */
  .products-grid {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 36px;
  }

  .empty-state {
    margin: 44px 0 0;
    padding: 36px;
    text-align: center;
    border: 1px dashed rgba(28, 26, 23, 0.28);
    border-radius: 6px;
    font-size: 16px;
    color: var(--text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
