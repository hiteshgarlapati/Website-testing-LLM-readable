---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object;
  image?: string;
  search?: boolean;
  noindex?: boolean;
}

const {
  title = "Oakline Furniture — Solid-Wood Furniture, Handcrafted in Michigan",
  description = "Solid-wood furniture made in small batches in Grand Rapids, Michigan. Twelve pieces, built to order with solid oak, walnut, maple, and cherry.",
  jsonLd,
  image = "/images/p1.png",
  // Only pages that render the catalogue get the search box; elsewhere it
  // would be a control with nothing to filter.
  search = false,
  noindex = false
} = Astro.props;

// Every absolute URL derives from the configured site, so pointing SITE_URL at
// the live domain moves canonical, OpenGraph and JSON-LD identifiers together.
const site = Astro.site?.origin ?? "https://oaklinefurniture.example";

// Crawlers and link unfurlers need an absolute image URL, never a local path.
const socialImage = image.startsWith('http') ? image : `${site}${image}`;

// build.format 'file' makes Astro.url.pathname carry the on-disk name
// (/index.html, /product/slug.html), but every link, sitemap entry and JSON-LD
// id uses the extensionless form the server resolves via try_files. Canonical
// has to name that same URL or it splits the indexing signal for each page.
const canonicalPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/(.)\/$/, '$1');
const canonical = new URL(canonicalPath || '/', site).href;

// Global Store Schema
const storeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FurnitureStore",
      "@id": `${site}/#store`,
      "name": "Oakline Furniture",
      "description": "Solid-wood beds, chairs, tables and sofas made in small batches in Grand Rapids, Michigan. Twelve pieces, built to order.",
      "url": `${site}/`,
      "telephone": "+1-616-555-0142",
      "email": "shop@oaklinefurniture.example",
      "priceRange": "$340-$3,240",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "418 Wealthy Street SE",
        "addressLocality": "Grand Rapids",
        "addressRegion": "MI",
        "postalCode": "49503",
        "addressCountry": "US"
      },
      "openingHours": "Tu-Sa 10:00-18:00"
    }
  ]
};

const finalJsonLd = jsonLd ? jsonLd : storeSchema;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <>
      <meta name="robots" content="index, follow" />
      <meta name="robots" content="max-image-preview:large, max-snippet:-1" />
    </>
  )}
  <link rel="canonical" href={canonical} />

  <!-- OpenGraph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Oakline Furniture" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />

  <!-- AI / LLM Scraper Links -->
  <link rel="alternate" type="text/markdown" title="LLM Plain Text Summary" href="/llms.txt" />
  <link rel="alternate" type="application/json" title="Structured Products JSON" href="/products.json" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD for AI and Web Crawlers -->
  <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd, null, 2)} />
</head>
<body>
  <a href="#catalogue" class="skip-link">Skip to product catalogue</a>

  <header>
    <div class="header-inner">
      <a href="/" aria-label="Oakline Furniture — home" class="logo-group">
        <span aria-hidden="true" class="logo-badge">O</span>
        <span class="logo-text">Oakline</span>
      </a>

      {search && (
        <form role="search" action="/browse" method="get" class="site-search">
          <span aria-hidden="true">⌕</span>
          <label for="q" class="visually-hidden">Search the catalogue by name, material or room</label>
          <input id="q" name="q" type="search" placeholder="Search the catalogue — “oak table”, “sofa”, “under $500”" autocomplete="off" />
          <button type="submit">Search</button>
        </form>
      )}

      <nav aria-label="Main navigation" class="nav-actions">
        <a href="/browse" class="btn-pill">Browse all</a>
        <a href="/#about" class="btn-pill">About</a>
        <a href="/llms.txt" target="_blank" rel="noopener" class="btn-pill btn-ai-pill" title="AI/LLM readable text format">llms.txt</a>
        <a href="/products.json" target="_blank" rel="noopener" class="btn-pill btn-ai-pill" title="Structured product JSON">products.json</a>
        <a href="/admin" class="btn-pill btn-admin">Admin</a>
      </nav>
    </div>
  </header>

  <slot />

  <footer>
    <div class="footer-inner">
      <div class="footer-col">
        <h2>Visit or write</h2>
        <ul>
          <li>418 Wealthy Street SE<br />Grand Rapids, MI 49503</li>
          <li>Tuesday–Saturday, 10am–6pm</li>
          <li><a href="tel:+16165550142">(616) 555-0142</a></li>
          <li><a href="mailto:shop@oaklinefurniture.example">shop@oaklinefurniture.example</a></li>
        </ul>
      </div>
      <div class="footer-col" style="max-width:38ch">
        <h2>Delivery</h2>
        <p>Free delivery and assembly within 90 miles. Flat-rate $180 crating anywhere else in the lower 48. Repairs on our own work are free for the first ten years.</p>
      </div>
      <div class="footer-col">
        <h2>Pages</h2>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/browse">Browse all</a></li>
          <li><a href="/#about">About us</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/products.json">products.json</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">© 2026 Oakline Furniture · Grand Rapids, Michigan · Pre-rendered HTML for web crawlers and AI agents.</div>
  </footer>
</body>
</html>
